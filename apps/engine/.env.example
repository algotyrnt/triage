# Engine Server Configuration
PORT=8080
TRIAGE_ENV=development

# Official Gemini API Configuration (google.golang.org/genai)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# GitHub App Integration Configuration
GITHUB_APP_ID=1092837
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# AST Repository Workspace Root
AST_WORKSPACE_ROOT=/path/to/monorepo
