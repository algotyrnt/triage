import { Navbar } from '@/components/Navbar';
import { Hero } from '@/components/Hero';
import { InteractiveSimulator } from '@/components/InteractiveSimulator';
import { ArchitectureSection } from '@/components/ArchitectureSection';
import { FeaturesGrid } from '@/components/FeaturesGrid';
import { SdkShowcase } from '@/components/SdkShowcase';
import { BenchmarksSection } from '@/components/BenchmarksSection';
import { FaqSection } from '@/components/FaqSection';
import { Footer } from '@/components/Footer';
import '@/styles/custom.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>triage — Zero-Overhead Go Crash Isolation & AI Diagnostics</title>
    <meta
      name="description"
      content="Intercept Go HTTP server panics non-blockingly, isolate the enclosing *ast.FuncDecl code block, and diagnose root causes instantly with AI."
    />
    <meta
      name="keywords"
      content="golang, go, panic isolation, crash reporting, AST parser, ai diagnostics, developer tools, observability, APM, zero overhead, github automation, bugfix pull requests"
    />
    <meta name="author" content="Punjitha Bandara (algotyrnt)" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://triage.algotyrnt.com/" />
    <meta name="theme-color" content="#0f172a" />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://triage.algotyrnt.com/" />
    <meta
      property="og:title"
      content="triage — Zero-Overhead Go Crash Isolation & AI Diagnostics"
    />
    <meta
      property="og:description"
      content="Intercept Go HTTP server panics non-blockingly, isolate the enclosing *ast.FuncDecl code block, and diagnose root causes instantly with AI."
    />
    <meta property="og:site_name" content="Triage" />
    <meta property="og:image" content="https://triage.algotyrnt.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Triage — Zero-Overhead Go Crash Isolation & AI Diagnostics"
    />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@algotyrnt" />
    <meta name="twitter:creator" content="@algotyrnt" />
    <meta
      name="twitter:title"
      content="triage — Zero-Overhead Go Crash Isolation & AI Diagnostics"
    />
    <meta
      name="twitter:description"
      content="Intercept Go HTTP server panics non-blockingly, isolate the enclosing *ast.FuncDecl code block, and diagnose root causes instantly with AI."
    />
    <meta name="twitter:image" content="https://triage.algotyrnt.com/og-image.png" />
    <meta
      name="twitter:image:alt"
      content="Triage — Zero-Overhead Go Crash Isolation & AI Diagnostics"
    />

    {/* Favicon & Fonts */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {/* Structured Data (JSON-LD) */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Triage',
        headline: 'Zero-Overhead Go Crash Isolation & AI Diagnostics',
        description:
          'Intercepts Go HTTP server panics non-blockingly, isolates enclosing *ast.FuncDecl code blocks, and diagnoses root causes with AI.',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Linux, macOS, Windows',
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'USD',
        },
        author: {
          '@type': 'Person',
          name: 'Punjitha Bandara',
          url: 'https://algotyrnt.com',
        },
        license: 'https://opensource.org/licenses/Apache-2.0',
        url: 'https://triage.algotyrnt.com',
        sameAs: ['https://github.com/algotyrnt/triage'],
      })}
    />
  </head>
  <body
    class="min-h-screen bg-slate-50 text-slate-900 font-sans antialiased selection:bg-indigo-500 selection:text-white"
  >
    <div class="flex flex-col min-h-screen">
      <Navbar client:load />
      <main class="flex-1">
        <Hero client:load />
        <InteractiveSimulator client:visible />
        <ArchitectureSection client:visible />
        <FeaturesGrid client:visible />
        <SdkShowcase client:visible />
        <BenchmarksSection client:visible />
        <FaqSection client:visible />
      </main>
      <Footer client:visible />
    </div>
  </body>
</html>
